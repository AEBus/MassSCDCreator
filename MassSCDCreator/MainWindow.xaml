<Window x:Class="MassSCDCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Texts[WindowTitle]}"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ChevronStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionSummaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="AudioSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionSummaryStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTemplateIssues}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PenumbraSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionSummaryStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPenumbraIssues}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBlockingIssues}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Texts[AppTitle]}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource IconRadioStyle}"
                             GroupName="Theme"
                             Content="&#xE713;"
                             ToolTip="{Binding Texts[ThemeSystem]}"
                             IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                             Command="{Binding SelectSystemThemeCommand}" />
                <RadioButton Style="{StaticResource IconRadioStyle}"
                             GroupName="Theme"
                             Content="&#xE706;"
                             ToolTip="{Binding Texts[ThemeLight]}"
                             IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                             Command="{Binding SelectLightThemeCommand}" />
                <RadioButton Style="{StaticResource IconRadioStyle}"
                             GroupName="Theme"
                             Margin="0"
                             Content="&#xE708;"
                             ToolTip="{Binding Texts[ThemeDark]}"
                             IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                             Command="{Binding SelectDarkThemeCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,12">
            <RadioButton Style="{StaticResource SegmentRadioStyle}"
                         GroupName="Mode"
                         Content="{Binding Texts[ModeSingleTitle]}"
                         IsChecked="{Binding IsSingleMode, Mode=OneWay}"
                         Command="{Binding SelectSingleModeCommand}" />
            <RadioButton Style="{StaticResource SegmentRadioStyle}"
                         GroupName="Mode"
                         Content="{Binding Texts[ModeBatchTitle]}"
                         IsChecked="{Binding IsBatchMode, Mode=OneWay}"
                         Command="{Binding SelectBatchModeCommand}" />
            <RadioButton Style="{StaticResource SegmentRadioStyle}"
                         GroupName="Mode"
                         Margin="0"
                         Content="{Binding Texts[ModeRefreshTitle]}"
                         IsChecked="{Binding IsRefreshMode, Mode=OneWay}"
                         Command="{Binding SelectRefreshModeCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <Border Style="{StaticResource SectionCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding InputLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,8,0" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" MinWidth="88" Command="{Binding BrowseInputCommand}" Content="{Binding Texts[BrowseButton]}" />
                        </Grid>
                        <CheckBox Margin="0,8,0,0"
                                  FontSize="13"
                                  IsChecked="{Binding RecursiveSearchEnabled}"
                                  Visibility="{Binding IsSingleMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  Content="{Binding Texts[RecursiveSearch]}" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowOutputOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox FontSize="13"
                                      IsChecked="{Binding UseCustomOutputPath}"
                                      Content="{Binding Texts[CustomOutputToggle]}"
                                      ToolTip="{Binding Texts[CustomOutputHint]}" />

                            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowOutputSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding OutputLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Margin="0,0,8,0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" MinWidth="88" Command="{Binding BrowseOutputCommand}" Content="{Binding Texts[BrowseButton]}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowOutputGoesToPenumbra, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding Texts[OutputGoesToPenumbra]}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding ShowOutputOption, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                   Text="{Binding Texts[RefreshInPlaceHint]}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,10,0,0" Padding="8,2,14,8">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource SectionHeaderToggleStyle}" IsChecked="{Binding IsAudioExpanded}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ChevronStyle}" Text="{Binding AudioChevron}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="{Binding Texts[SectionAudio]}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource AudioSummaryStyle}" HorizontalAlignment="Right" Text="{Binding AudioSectionSummary}" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel Margin="6,4,0,0" Visibility="{Binding IsAudioExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource SectionDividerStyle}" Margin="0,0,0,12" />

                            <TextBlock Style="{StaticResource GroupLabelStyle}" Text="{Binding Texts[TemplateSectionTitle]}" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource OptionRadioStyle}"
                                             GroupName="Template"
                                             Content="{Binding Texts[TemplateBuiltInTitle]}"
                                             ToolTip="{Binding Texts[TemplateBuiltInDesc]}"
                                             IsChecked="{Binding IsBuiltInTemplateSelected, Mode=OneWay}"
                                             Command="{Binding SelectBuiltInTemplateCommand}" />
                                <RadioButton Style="{StaticResource OptionRadioStyle}"
                                             GroupName="Template"
                                             Content="{Binding Texts[TemplateCustomTitle]}"
                                             ToolTip="{Binding Texts[TemplateCustomDesc]}"
                                             IsChecked="{Binding IsCustomTemplateSelected, Mode=OneWay}"
                                             Command="{Binding SelectCustomTemplateCommand}" />
                                <RadioButton Style="{StaticResource OptionRadioStyle}"
                                             GroupName="Template"
                                             Content="{Binding Texts[TemplateCurrentTitle]}"
                                             ToolTip="{Binding Texts[TemplateCurrentDesc]}"
                                             Visibility="{Binding ShowTemplateCurrentOption, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             IsChecked="{Binding IsCurrentTemplateSelected, Mode=OneWay}"
                                             Command="{Binding SelectCurrentTemplateCommand}" />
                            </WrapPanel>

                            <Grid Margin="0,8,0,0" Visibility="{Binding ShowTemplatePathSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Margin="0,0,8,0" Text="{Binding TemplateScdPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" MinWidth="88" Command="{Binding BrowseTemplateCommand}" Content="{Binding Texts[BrowseButton]}" />
                            </Grid>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowRefreshActionSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource GroupLabelStyle}" Text="{Binding Texts[RefreshActionTitle]}" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="RefreshAction"
                                                 Content="{Binding Texts[RefreshActionTemplateOnlyTitle]}"
                                                 ToolTip="{Binding Texts[RefreshActionTemplateOnlyDesc]}"
                                                 IsChecked="{Binding IsRefreshTemplateOnlySelected, Mode=OneWay}"
                                                 Command="{Binding SelectRefreshTemplateOnlyCommand}" />
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="RefreshAction"
                                                 Content="{Binding Texts[RefreshActionAudioOnlyTitle]}"
                                                 ToolTip="{Binding Texts[RefreshActionAudioOnlyDesc]}"
                                                 IsChecked="{Binding IsRefreshAudioOnlySelected, Mode=OneWay}"
                                                 Command="{Binding SelectRefreshAudioOnlyCommand}" />
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="RefreshAction"
                                                 Content="{Binding Texts[RefreshActionTemplateAndAudioTitle]}"
                                                 ToolTip="{Binding Texts[RefreshActionTemplateAndAudioDesc]}"
                                                 IsChecked="{Binding IsRefreshTemplateAndAudioSelected, Mode=OneWay}"
                                                 Command="{Binding SelectRefreshTemplateAndAudioCommand}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowAudioEncodingOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,14,0,6" Style="{StaticResource GroupLabelStyle}" Text="{Binding Texts[AudioRecommendedTitle]}" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="AudioProfile"
                                                 Content="{Binding Texts[AudioProfileRecommendedTitle]}"
                                                 ToolTip="{Binding Texts[AudioProfileRecommendedDesc]}"
                                                 IsChecked="{Binding IsRecommendedAudioProfileSelected, Mode=OneWay}"
                                                 Command="{Binding SelectRecommendedAudioProfileCommand}" />
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="AudioProfile"
                                                 Content="{Binding Texts[AudioProfileCustomTitle]}"
                                                 ToolTip="{Binding Texts[AudioProfileCustomDesc]}"
                                                 IsChecked="{Binding IsCustomAudioProfileSelected, Mode=OneWay}"
                                                 Command="{Binding SelectCustomAudioProfileCommand}" />
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="AudioProfile"
                                                 Content="{Binding Texts[AudioProfileOriginalOggTitle]}"
                                                 ToolTip="{Binding Texts[AudioProfileOriginalOggDesc]}"
                                                 IsChecked="{Binding IsOriginalOggAudioProfileSelected, Mode=OneWay}"
                                                 Command="{Binding SelectOriginalOggAudioProfileCommand}" />
                                </WrapPanel>

                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding ShowOriginalOggHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Text="{Binding Texts[AudioProfileOriginalOggHint]}" />

                                <Border Style="{StaticResource SubtleCardBorderStyle}"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding ShowCustomAudioOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[AudioCustomModeTitle]}" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                         GroupName="AdvancedMode"
                                                         Content="{Binding Texts[AdvancedModeQuality]}"
                                                         IsChecked="{Binding IsAdvancedQualityModeSelected, Mode=OneWay}"
                                                         Command="{Binding SelectAdvancedQualityModeCommand}" />
                                            <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                         GroupName="AdvancedMode"
                                                         Content="{Binding Texts[AdvancedModeBitrate]}"
                                                         IsChecked="{Binding IsAdvancedBitrateModeSelected, Mode=OneWay}"
                                                         Command="{Binding SelectAdvancedBitrateModeCommand}" />
                                        </WrapPanel>
                                        <Grid Visibility="{Binding IsAdvancedQualityModeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider VerticalAlignment="Center"
                                                    Minimum="1"
                                                    Maximum="10"
                                                    TickFrequency="0.5"
                                                    IsSnapToTickEnabled="False"
                                                    Value="{Binding AdvancedQualitySliderValue, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" MinWidth="30" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Text="{Binding AdvancedValue}" />
                                        </Grid>
                                        <TextBox Width="120"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding IsAdvancedQualityModeSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                 Text="{Binding AdvancedValue, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding AdvancedModeHint}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowFfmpegOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[FfmpegLabel]}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Margin="0,0,8,0" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" MinWidth="88" Command="{Binding BrowseFfmpegCommand}" Content="{Binding Texts[BrowseButton]}" />
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Margin="0,0,8,0" Command="{Binding DownloadOrUpdateFfmpegCommand}" Content="{Binding Texts[FfmpegInstallButton]}" />
                                        <Button Command="{Binding ResetFfmpegStartupCheckCommand}" Content="{Binding Texts[FfmpegResetStartupCheckButton]}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Texts[FfmpegHint]}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Visibility="{Binding ShowFfmpegStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding FfmpegInstallStatus}" />
                                </StackPanel>
                            </StackPanel>

                            <CheckBox Margin="0,14,0,0" FontSize="13" IsChecked="{Binding EnableLoop}" Content="{Binding Texts[LoopToggle]}" ToolTip="{Binding Texts[LoopHint]}" />
                            <CheckBox Margin="0,4,0,0"
                                      FontSize="13"
                                      IsChecked="{Binding NormalizeLoudness}"
                                      Visibility="{Binding ShowFfmpegOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Content="{Binding Texts[NormalizeLoudnessToggle]}"
                                      ToolTip="{Binding Texts[NormalizeLoudnessHint]}" />
                            <CheckBox Margin="0,4,0,0"
                                      FontSize="13"
                                      IsChecked="{Binding SaveIntermediateOggFiles}"
                                      Visibility="{Binding ShowIntermediateOggOption, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Content="{Binding Texts[SaveOggToggle]}" />

                            <Border Style="{StaticResource DangerCardBorderStyle}"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasTemplateIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding TemplateIssues}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardBorderStyle}"
                        Margin="0,10,0,0"
                        Padding="8,2,14,8"
                        Visibility="{Binding ShowPenumbraSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource SectionHeaderToggleStyle}" IsChecked="{Binding IsPenumbraExpanded}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ChevronStyle}" Text="{Binding PenumbraChevron}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="{Binding Texts[SectionPenumbra]}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource PenumbraSummaryStyle}" HorizontalAlignment="Right" Text="{Binding SummaryPenumbraValue}" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel Margin="6,4,0,0" Visibility="{Binding IsPenumbraExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource SectionDividerStyle}" Margin="0,0,0,12" />

                            <CheckBox FontSize="13" IsChecked="{Binding PenumbraExportEnabled}" Content="{Binding Texts[PenumbraEnable]}" />

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowPenumbraSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[PenumbraModRootLabel]}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Margin="0,0,8,0" Text="{Binding PenumbraModRootPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" MinWidth="88" Command="{Binding BrowsePenumbraModRootCommand}" Content="{Binding Texts[BrowseButton]}" />
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="PlaylistMode"
                                                 Content="{Binding Texts[PenumbraCreateMode]}"
                                                 IsChecked="{Binding IsCreatePlaylistModeSelected, Mode=OneWay}"
                                                 Command="{Binding SelectCreatePlaylistModeCommand}" />
                                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                 GroupName="PlaylistMode"
                                                 Content="{Binding Texts[PenumbraAppendMode]}"
                                                 IsChecked="{Binding IsAppendPlaylistModeSelected, Mode=OneWay}"
                                                 Command="{Binding SelectAppendPlaylistModeCommand}" />
                                </WrapPanel>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowCreatePlaylistFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[PlaylistNameLabel]}" />
                                    <TextBox Text="{Binding PenumbraPlaylistName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowAppendPlaylistFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[ExistingPlaylistLabel]}" />
                                    <ComboBox ItemsSource="{Binding PenumbraPlaylistCandidates}"
                                              SelectedItem="{Binding SelectedPenumbraPlaylistCandidate}"
                                              DisplayMemberPath="DisplayText"
                                              IsEnabled="{Binding HasPenumbraPlaylistCandidates}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Visibility="{Binding ShowNoPlaylistsFound, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Texts[NoPlaylistsFound]}" />
                                    <Border Style="{StaticResource WarningCardBorderStyle}"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding ShowInferredRelativeFolderWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource WarningTextBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding InferredRelativeFolderWarning}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[RelativeFolderLabel]}" />
                                <TextBox Text="{Binding PenumbraRelativeScdFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Texts[RelativeFolderHint]}" />

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowPenumbraGamePathCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[ExistingGamePathsLabel]}" />
                                    <ComboBox ItemsSource="{Binding PenumbraGamePathCandidates}" SelectedItem="{Binding SelectedPenumbraGamePathCandidate}" DisplayMemberPath="DisplayText" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Texts[ExistingGamePathsHint]}" />
                                </StackPanel>

                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="{Binding Texts[GamePathsLabel]}" />
                                <TextBox MinHeight="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding PenumbraGamePathsText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Texts[GamePathsHint]}" />
                            </StackPanel>

                            <Border Style="{StaticResource DangerCardBorderStyle}"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasPenumbraIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding PenumbraIssues}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,10,0,16" Padding="8,2,14,8">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource SectionHeaderToggleStyle}" IsChecked="{Binding IsLogExpanded}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ChevronStyle}" Text="{Binding LogChevron}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="{Binding Texts[LogTitle]}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionSummaryStyle}" HorizontalAlignment="Right" Text="{Binding LogSummary}" />
                            </Grid>
                        </ToggleButton>
                        <TextBox Margin="6,8,0,0"
                                 Height="200"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Visible"
                                 HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsLogExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Text="{Binding LogText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="16,10,16,16" Style="{StaticResource SectionCardBorderStyle}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Row="0"
                             Grid.ColumnSpan="2"
                             Margin="0,0,0,10"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding ActionBarHeadlineText}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource ActionDetailStyle}" MaxHeight="32" Text="{Binding ActionBarDetailText}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="{Binding Texts[OpenOutputFolder]}"
                            Visibility="{Binding ShowResultActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding OpenPlaylistCommand}"
                            Content="{Binding Texts[OpenPlaylist]}"
                            Visibility="{Binding ShowResultActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0"
                            MinWidth="88"
                            Command="{Binding CancelCommand}"
                            Content="{Binding Texts[CancelButton]}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button MinWidth="120"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding StartCommand}"
                            Content="{Binding Texts[StartButton]}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
